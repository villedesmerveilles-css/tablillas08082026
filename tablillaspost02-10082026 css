/* --- TABLILLA MINIMALISTA --- */
.VdMNoticeCard {
    max-width: 520px;
    width: 95%;
    margin: 35px auto;
    background: 
        linear-gradient(var(--n2), var(--n2)) padding-box,
        linear-gradient(135deg, var(--group-color, var(--gg6)) 0%, var(--gg2) 100%) border-box;
    border: 1.5px solid transparent;
    border-radius: 36px;
    padding: 24px;
    box-sizing: border-box;
    font-family: var(--f3);
    box-shadow: 0 15px 35px rgba(0,0,0,0.25);
}




.VdMNotice-inner {
    background: var(--n1);
    border-radius: 26px;
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.03);
    border: 1px solid rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: hidden;
}




.VdMNotice-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 110px;
    height: 110px;
    background: linear-gradient(135deg, var(--group-color, var(--gg6)) 0%, var(--gg2) 100%);
    border-bottom-right-radius: 100%;
    opacity: 0.15;
    pointer-events: none;
}




.VdMNotice-inner::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 110px;
    height: 110px;
    background: linear-gradient(135deg, var(--group-color, var(--gg6)) 0%, var(--gg2) 100%);
    border-top-left-radius: 100%;
    opacity: 0.15;
    pointer-events: none;
}




.VdMNotice-title {
    font-family: var(--f1);
    font-size: 18px;
    color: var(--n4);
    margin: 0;
    letter-spacing: 3px;
    text-transform: uppercase;
    line-height: 1.2;
}




.VdMNotice-text {
    font-size: 13.5px;
    color: var(--n4);
    line-height: 1.85;
    text-align: justify;
    opacity: 0.9;
    margin: 0;
    z-index: 1;
}




.VdMNotice-footer {
    display: flex;
    justify-content: space-around;
    align-items: center;
    width: 100%;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    z-index: 1;
}




.VdMNotice-data-item {
    font-family: var(--f2);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--group-color, var(--gg6));
    opacity: 0.8;
    text-align: center;
    flex: 1;
}




.VdMNoticeCard b, .VdMNoticeCard strong, 
.VdMNoticeCard i, .VdMNoticeCard em {
    color: var(--group-color, var(--gg6));
}
